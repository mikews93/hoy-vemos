<?xml version="1.0" encoding="UTF-8"?>
<!-- App de Hoy Vemos para televisores Samsung (Tizen). No trae la app adentro: muestra la web en modo televisor
     (?tv=1) dentro de un marco (index.html), así se actualiza sola con cada versión y los proxies que cuidan las
     claves siguen funcionando. El marco es el que abre Netflix, Prime Video, etc. (privilegio application.launch). -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://hoyvemos.migueblanco.com/tizen" version="1.0.0" viewmodes="maximized">
  <tizen:application id="HoyVemosTV.HoyVemos" package="HoyVemosTV" required_version="5.0"/>
  <tizen:profile name="tv-samsung"/>
  <name>Hoy Vemos</name>
  <icon src="icon.png"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>hoyvemos.migueblanco.com *.supabase.co *.youtube-nocookie.com *.youtube.com</tizen:allow-navigation>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
