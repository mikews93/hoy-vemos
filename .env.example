# --- Supabase (cuentas y sincronización entre los dos teléfonos) ---
# Supabase → Project Settings → API. La clave "anon/publishable" es pública por diseño (los datos los protege RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Datos de películas ---
# En Vercel NO uses las variables VITE_ de abajo: configura TMDB_TOKEN y OMDB_KEY (sin VITE_) y el proxy /api las usa.
# Solo para correrla en tu computador sin el proxy:
VITE_TMDB_TOKEN=
VITE_OMDB_KEY=
# País para la disponibilidad en plataformas (código ISO, ej. CO, MX, ES, US)
VITE_REGION=CO
