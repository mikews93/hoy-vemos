# Token de lectura de TMDB (https://www.themoviedb.org/settings/api, "API Read Access Token")
VITE_TMDB_TOKEN=
# Clave de OMDb para notas de IMDb, Rotten Tomatoes y Metacritic (https://www.omdbapi.com/apikey.aspx)
VITE_OMDB_KEY=
# País para la disponibilidad en plataformas (código ISO, ej. CO, MX, ES, US)
VITE_REGION=CO
